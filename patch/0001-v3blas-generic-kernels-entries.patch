+++ b/kernel/generic/ew.c
@@ -0,0 +1,80 @@
+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Real (s/d) Layer 0 bodies.
+
+Compiled once per precision with -DV3_S or -DV3_D.  Layer 0 is flat CBLAS: each
+operand carries its own inc, any inc may be 0 (broadcast one element to all n),
+negative (walk backwards from element n-1) or positive.
+
+A negative inc is normalised by starting the walk at (1-n)*inc, which is the
+last element.  An inc of 0 leaves the index at 0 forever, which is exactly the
+broadcast.  Nothing is written past element n-1.
+*****************************************************************************/
+
+#include <stdint.h>
+#include <math.h>
+
+#if defined(V3_S)
+#define P1(x) s1##x
+typedef float V3F;
+#define V3SQRT(x) sqrtf(x)
+#else
+#define P1(x) d1##x
+typedef double V3F;
+#define V3SQRT(x) sqrt(x)
+#endif
+
+/* int64_t, not BLASLONG: the public entry narrows from blasint, the body
+   widens so a Layer-0 call cannot truncate inside a chunked split. */
+#define N_ int64_t
+
+#define START(inc) ((inc) < 0 ? (1 - n) * (inc) : 0)
+
+int P1(scal_k)(N_ n, V3F a, const V3F *x, N_ incx, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iz += incz)
+		z[iz] = a * x[ix];
+	return 0;
+}
+
+int P1(axpy_k)(N_ n, V3F a, const V3F *x, N_ incx, V3F *y, N_ incy)
+{
+	N_ i, ix = START(incx), iy = START(incy);
+	for (i = 0; i < n; i++, ix += incx, iy += incy)
+		y[iy] += a * x[ix];
+	return 0;
+}
+
+int P1(axpby_k)(N_ n, V3F a, const V3F *x, N_ incx,
+                V3F b, const V3F *y, N_ incy, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iy = START(incy), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iy += incy, iz += incz)
+		z[iz] = a * x[ix] + b * y[iy];
+	return 0;
+}
+
+int P1(had_k)(N_ n, const V3F *x, N_ incx, const V3F *y, N_ incy,
+              V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iy = START(incy), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iy += incy, iz += incz)
+		z[iz] = x[ix] * y[iy];
+	return 0;
+}
+
+int P1(sqr_k)(N_ n, const V3F *x, N_ incx, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iz += incz)
+		z[iz] = x[ix] * x[ix];
+	return 0;
+}
+
+int P1(sqrt_k)(N_ n, const V3F *x, N_ incx, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iz += incz)
+		z[iz] = V3SQRT(x[ix]);
+	return 0;
+}
