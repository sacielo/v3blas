+#ifndef V3BLAS_H
+#define V3BLAS_H
+
+#include <stdint.h>
+#include "cblas.h"		/* blasint, the host index type for Layer 0 */
+
+#define V3BLAS_VERSION_MAJOR 1
+#define V3BLAS_VERSION_MINOR 0
+#define V3BLAS_VERSION_PATCH 0
+
+/* Error status.  Set, never returned, exactly as CBLAS specifies it. */
+#define V3BLAS_OK		0
+#define V3BLAS_PARAM		1
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * <p> is the precision (s d c z), T is the real element type: float for s,
+ * double for the rest.  For c and z one complex value occupies two adjacent
+ * T, so a <p>3v component stride is 2 * cinc reals and every product below is
+ * bilinear with no conjugation.
+ *
+ * Handles are 48 B and 24 B.  cinc is 3 * inc, stored rather than derived.
+ */
+/* A kernel scalar is a plain T for s/d and a real pair for c/z.  Both are
+   macros taking the element type, so the element type is substituted before
+   the scalar declaration is expanded. */
+#define V3_SCALAR_REAL(T, R, I)  T R
+#define V3_SCALAR_CPLX(T, R, I)  T R, T I
+
+#define V3BLAS_API(P, T, S)								\
+										\
+typedef struct { T *x, *y, *z; int64_t n, inc, cinc; } P##3v;			\
+typedef struct { T *p;            int64_t n, inc;      } P##1v;			\
+										\
+/* Layer 1 -- one argument per operand, n and inc in the handle */		\
+void P##3scal     (const P##3v *x, S(T, a, ai), P##3v *z);				\
+void P##3axpy     (const P##3v *x, S(T, a, ai), P##3v *y);				\
+void P##3axpby    (const P##3v *x, S(T, a, ai), const P##3v *y, S(T, b, bi), P##3v *z);	\
+void P##3had      (const P##3v *x, const P##3v *y, P##3v *z);		\
+void P##3cross    (const P##3v *x, const P##3v *y, P##3v *c);			\
+void P##3crossscal(const P##3v *x, const P##3v *y, S(T, a, ai), P##3v *c);		\
+void P##3dot      (const P##3v *x, const P##3v *y, P##1v *r);		\
+void P##3sqr      (const P##3v *x, P##3v *z);				\
+void P##3crossdot (const P##3v *x, const P##3v *y, const P##3v *z, P##1v *r);\
+void P##3crosssqr (const P##3v *x, const P##3v *y, P##1v *r);		\
+										\
+/* Forks -- all share the first operand and vary the second */		\
+void P##3crossxy_crossxz(const P##3v *x, const P##3v *y, const P##3v *z,	\
+			 P##3v *c1, P##3v *c2);				\
+void P##3crossxy_dotxz  (const P##3v *x, const P##3v *y, const P##3v *z,	\
+			 P##3v *c, P##1v *r);				\
+void P##3dotxy_dotxz    (const P##3v *x, const P##3v *y, const P##3v *z,	\
+			 P##1v *r1, P##1v *r2);				\
+										\
+/* Layer 0 -- flat CBLAS */						\
+void P##1scal (blasint n, S(T, a, ai), const T *x, blasint incx, T *z, blasint incz);\
+void P##1axpy (blasint n, S(T, a, ai), const T *x, blasint incx, T *y, blasint incy);\
+void P##1axpby(blasint n, S(T, a, ai), const T *x, blasint incx,		\
+	       S(T, b, bi), const T *y, blasint incy, T *z, blasint incz);	\
+void P##1had  (blasint n, const T *x, blasint incx,				\
+	       const T *y, blasint incy, T *z, blasint incz);		\
+void P##1sqr  (blasint n, const T *x, blasint incx, T *z, blasint incz);	\
+void P##1sqrt (blasint n, const T *x, blasint incx, T *z, blasint incz);	\
+										\
+/* Constructors -- views own nothing; _create is the only allocation */	\
+P##3v *P##3_create(int64_t n);						\
+P##3v *P##3_wrap(P##3v *out, T *base, int64_t n, int64_t inc);		\
+P##3v *P##3_wrap_component(P##3v *out, const P##3v *v, int k);		\
+P##1v  P##3_component(const P##3v *v, int k);				\
+int64_t P##3_pitch(int64_t n);		/* ((3n + 7) / 8) * 8, fixed at 8 */	\
+void    P##3_destroy(P##3v *v);						\
+										\
+P##1v *P##1_create(blasint n);						\
+P##1v *P##1_wrap(P##1v *out, T *base, blasint n, blasint inc);		\
+void    P##1_destroy(P##1v *v);						\
+										\
+/* Error status -- per-precision thread-local */				\
+void P##3_set_error_status(int status);					\
+int  P##3_get_error_status(void);
+
+V3BLAS_API(s, float, V3_SCALAR_REAL)
+V3BLAS_API(d, double, V3_SCALAR_REAL)
+#if defined(BUILD_COMPLEX)
+V3BLAS_API(c, float, V3_SCALAR_CPLX)
+V3BLAS_API(z, double, V3_SCALAR_CPLX)
+#endif
+
+#undef V3BLAS_API
+#undef V3_SCALAR_REAL
+#undef V3_SCALAR_CPLX
+
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif	/* V3BLAS_H */
