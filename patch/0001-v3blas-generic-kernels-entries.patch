+++ b/kernel/generic/zv3.c
@@ -0,0 +1,285 @@
+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Complex (c/z) Layer 1 bodies.
+
+Compiled once per precision with -DV3_C or -DV3_Z.  V3F is the *real* element
+type: one complex value occupies two adjacent V3F, so every offset below is
+doubled and component k of element i starts at 2*(i*inc + k*cinc) reals.
+
+Every product is bilinear -- no conjugation anywhere.  BIL(R,I,X,Y) expands
+the product of complex X by complex Y into R and I.
+*****************************************************************************/
+
+#include <stdint.h>
+
+#if defined(V3_C)
+#define P3(x) c3##x
+typedef float V3F;
+#else
+#define P3(x) z3##x
+typedef double V3F;
+#endif
+
+/* int64_t, not BLASLONG: N = 1e8..1e10 overflows a 32-bit index and Layer 1
+   promises 64.  BLASLONG is 32-bit in a default OpenBLAS build. */
+#define N_ int64_t
+
+#define X(k) ((x) + 2 * (i * inc + (k) * cinc))
+#define Y(k) ((y) + 2 * (i * inc + (k) * cinc))
+#define Z(k) ((z) + 2 * (i * inc + (k) * cinc))
+#define C(k) ((c) + 2 * (i * inc + (k) * cinc))
+#define C1(k) ((c1) + 2 * (i * inc + (k) * cinc))
+#define C2(k) ((c2) + 2 * (i * inc + (k) * cinc))
+#define R(k) ((r) + 2 * (i * inc + (k) * cinc))
+#define R1(k) ((r1) + 2 * (i * inc + (k) * cinc))
+#define R2(k) ((r2) + 2 * (i * inc + (k) * cinc))
+
+/* product of the complex values p and q, no conjugate */
+#define BIL(pr, pi, qr, qi, kr, ki)	\
+	do {				\
+		(kr) = (pr) * (qr) - (pi) * (qi);	\
+		(ki) = (pr) * (qi) + (pi) * (qr);	\
+	} while (0)
+
+/* a complex scalar scaled onto a real scalar */
+#define BILA(pr, pi, kr, ki)	\
+	do {			\
+		(kr) = ar * (pr) - ai * (pi);	\
+		(ki) = ar * (pi) + ai * (pr);	\
+	} while (0)
+
+int P3(cross_k)(N_ n, const V3F *x, const V3F *y, V3F *c,
+                N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F t0r, t0i, t1r, t1i, t2r, t2i, p, q;
+		BIL(X(1)[0], X(1)[1], Y(2)[0], Y(2)[1], p, q);
+		BIL(X(2)[0], X(2)[1], Y(1)[0], Y(1)[1], t0r, t0i);
+		C(0)[0] = p - t0r;  C(0)[1] = q - t0i;
+		BIL(X(2)[0], X(2)[1], Y(0)[0], Y(0)[1], p, q);
+		BIL(X(0)[0], X(0)[1], Y(2)[0], Y(2)[1], t1r, t1i);
+		C(1)[0] = p - t1r;  C(1)[1] = q - t1i;
+		BIL(X(0)[0], X(0)[1], Y(1)[0], Y(1)[1], p, q);
+		BIL(X(1)[0], X(1)[1], Y(0)[0], Y(0)[1], t2r, t2i);
+		C(2)[0] = p - t2r;  C(2)[1] = q - t2i;
+	}
+	return 0;
+}
+
+int P3(crossscal_k)(N_ n, const V3F *x, const V3F *y, V3F ar, V3F ai,
+                    V3F *c, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F t0r, t0i, t1r, t1i, t2r, t2i, p, q;
+		BIL(X(1)[0], X(1)[1], Y(2)[0], Y(2)[1], p, q);
+		BIL(X(2)[0], X(2)[1], Y(1)[0], Y(1)[1], t0r, t0i);
+		BILA(p - t0r, q - t0i, C(0)[0], C(0)[1]);
+		BIL(X(2)[0], X(2)[1], Y(0)[0], Y(0)[1], p, q);
+		BIL(X(0)[0], X(0)[1], Y(2)[0], Y(2)[1], t1r, t1i);
+		BILA(p - t1r, q - t1i, C(1)[0], C(1)[1]);
+		BIL(X(0)[0], X(0)[1], Y(1)[0], Y(1)[1], p, q);
+		BIL(X(1)[0], X(1)[1], Y(0)[0], Y(0)[1], t2r, t2i);
+		BILA(p - t2r, q - t2i, C(2)[0], C(2)[1]);
+	}
+	return 0;
+}
+
+int P3(crossdot_k)(N_ n, const V3F *x, const V3F *y, const V3F *z,
+                   V3F *r, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F t0r, t0i, t1r, t1i, t2r, t2i, p, q, sr = 0, si = 0;
+		BIL(X(1)[0], X(1)[1], Y(2)[0], Y(2)[1], t0r, t0i);
+		BIL(X(2)[0], X(2)[1], Y(1)[0], Y(1)[1], p, q);
+		t0r -= p;  t0i -= q;
+		BIL(X(2)[0], X(2)[1], Y(0)[0], Y(0)[1], t1r, t1i);
+		BIL(X(0)[0], X(0)[1], Y(2)[0], Y(2)[1], p, q);
+		t1r -= p;  t1i -= q;
+		BIL(X(0)[0], X(0)[1], Y(1)[0], Y(1)[1], t2r, t2i);
+		BIL(X(1)[0], X(1)[1], Y(0)[0], Y(0)[1], p, q);
+		t2r -= p;  t2i -= q;
+		BIL(t0r, t0i, Z(0)[0], Z(0)[1], p, q); sr += p;  si += q;
+		BIL(t1r, t1i, Z(1)[0], Z(1)[1], p, q); sr += p;  si += q;
+		BIL(t2r, t2i, Z(2)[0], Z(2)[1], p, q); sr += p;  si += q;
+		R(0)[0] = sr;  R(0)[1] = si;
+	}
+	return 0;
+}
+
+int P3(crosssqr_k)(N_ n, const V3F *x, const V3F *y, V3F *r,
+                   N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F t0r, t0i, t1r, t1i, t2r, t2i, p, q, sr = 0, si = 0;
+		BIL(X(1)[0], X(1)[1], Y(2)[0], Y(2)[1], t0r, t0i);
+		BIL(X(2)[0], X(2)[1], Y(1)[0], Y(1)[1], p, q);
+		t0r -= p;  t0i -= q;
+		BIL(X(2)[0], X(2)[1], Y(0)[0], Y(0)[1], t1r, t1i);
+		BIL(X(0)[0], X(0)[1], Y(2)[0], Y(2)[1], p, q);
+		t1r -= p;  t1i -= q;
+		BIL(X(0)[0], X(0)[1], Y(1)[0], Y(1)[1], t2r, t2i);
+		BIL(X(1)[0], X(1)[1], Y(0)[0], Y(0)[1], p, q);
+		t2r -= p;  t2i -= q;
+		BIL(t0r, t0i, t0r, t0i, p, q); sr += p;  si += q;
+		BIL(t1r, t1i, t1r, t1i, p, q); sr += p;  si += q;
+		BIL(t2r, t2i, t2r, t2i, p, q); sr += p;  si += q;
+		R(0)[0] = sr;  R(0)[1] = si;
+	}
+	return 0;
+}
+
+int P3(dot_k)(N_ n, const V3F *x, const V3F *y, V3F *r, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F p, q, sr = 0, si = 0;
+		BIL(X(0)[0], X(0)[1], Y(0)[0], Y(0)[1], p, q); sr += p;  si += q;
+		BIL(X(1)[0], X(1)[1], Y(1)[0], Y(1)[1], p, q); sr += p;  si += q;
+		BIL(X(2)[0], X(2)[1], Y(2)[0], Y(2)[1], p, q); sr += p;  si += q;
+		R(0)[0] = sr;  R(0)[1] = si;
+	}
+	return 0;
+}
+
+int P3(sqr_k)(N_ n, const V3F *x, V3F *z, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F p, q, sr = 0, si = 0;
+		BIL(X(0)[0], X(0)[1], X(0)[0], X(0)[1], p, q); sr += p;  si += q;
+		BIL(X(1)[0], X(1)[1], X(1)[0], X(1)[1], p, q); sr += p;  si += q;
+		BIL(X(2)[0], X(2)[1], X(2)[0], X(2)[1], p, q); sr += p;  si += q;
+		Z(0)[0] = sr;  Z(0)[1] = si;
+	}
+	return 0;
+}
+
+int P3(had_k)(N_ n, const V3F *x, const V3F *y, V3F *z, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		BIL(X(0)[0], X(0)[1], Y(0)[0], Y(0)[1], Z(0)[0], Z(0)[1]);
+		BIL(X(1)[0], X(1)[1], Y(1)[0], Y(1)[1], Z(1)[0], Z(1)[1]);
+		BIL(X(2)[0], X(2)[1], Y(2)[0], Y(2)[1], Z(2)[0], Z(2)[1]);
+	}
+	return 0;
+}
+
+int P3(scal_k)(N_ n, const V3F *x, V3F ar, V3F ai, V3F *z, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		BILA(X(0)[0], X(0)[1], Z(0)[0], Z(0)[1]);
+		BILA(X(1)[0], X(1)[1], Z(1)[0], Z(1)[1]);
+		BILA(X(2)[0], X(2)[1], Z(2)[0], Z(2)[1]);
+	}
+	return 0;
+}
+
+int P3(axpy_k)(N_ n, const V3F *x, V3F ar, V3F ai, const V3F *y, V3F *z,
+               N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		BILA(X(0)[0], X(0)[1], Z(0)[0], Z(0)[1]);
+		Z(0)[0] += Y(0)[0];  Z(0)[1] += Y(0)[1];
+		BILA(X(1)[0], X(1)[1], Z(1)[0], Z(1)[1]);
+		Z(1)[0] += Y(1)[0];  Z(1)[1] += Y(1)[1];
+		BILA(X(2)[0], X(2)[1], Z(2)[0], Z(2)[1]);
+		Z(2)[0] += Y(2)[0];  Z(2)[1] += Y(2)[1];
+	}
+	return 0;
+}
+
+int P3(axpby_k)(N_ n, const V3F *x, V3F ar, V3F ai,
+                const V3F *y, V3F br, V3F bi, V3F *z, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F p, q;
+		BILA(X(0)[0], X(0)[1], p, q);
+		BIL(br, bi, Y(0)[0], Y(0)[1], Z(0)[0], Z(0)[1]);
+		Z(0)[0] += p;  Z(0)[1] += q;
+		BILA(X(1)[0], X(1)[1], p, q);
+		BIL(br, bi, Y(1)[0], Y(1)[1], Z(1)[0], Z(1)[1]);
+		Z(1)[0] += p;  Z(1)[1] += q;
+		BILA(X(2)[0], X(2)[1], p, q);
+		BIL(br, bi, Y(2)[0], Y(2)[1], Z(2)[0], Z(2)[1]);
+		Z(2)[0] += p;  Z(2)[1] += q;
+	}
+	return 0;
+}
+
+/* ---- forks: all share the first operand, vary the second ---- */
+
+int P3(crossxy_crossxz_k)(N_ n, const V3F *x, const V3F *y, const V3F *z,
+                          V3F *c1, V3F *c2, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F t0r, t0i, t1r, t1i, t2r, t2i, p, q;
+		BIL(X(1)[0], X(1)[1], Y(2)[0], Y(2)[1], t0r, t0i);
+		BIL(X(2)[0], X(2)[1], Y(1)[0], Y(1)[1], p, q);
+		C1(0)[0] = t0r - p;  C1(0)[1] = t0i - q;
+		BIL(X(2)[0], X(2)[1], Y(0)[0], Y(0)[1], t1r, t1i);
+		BIL(X(0)[0], X(0)[1], Y(2)[0], Y(2)[1], p, q);
+		C1(1)[0] = t1r - p;  C1(1)[1] = t1i - q;
+		BIL(X(0)[0], X(0)[1], Y(1)[0], Y(1)[1], t2r, t2i);
+		BIL(X(1)[0], X(1)[1], Y(0)[0], Y(0)[1], p, q);
+		C1(2)[0] = t2r - p;  C1(2)[1] = t2i - q;
+		BIL(X(1)[0], X(1)[1], Z(2)[0], Z(2)[1], t0r, t0i);
+		BIL(X(2)[0], X(2)[1], Z(1)[0], Z(1)[1], p, q);
+		C2(0)[0] = t0r - p;  C2(0)[1] = t0i - q;
+		BIL(X(2)[0], X(2)[1], Z(0)[0], Z(0)[1], t1r, t1i);
+		BIL(X(0)[0], X(0)[1], Z(2)[0], Z(2)[1], p, q);
+		C2(1)[0] = t1r - p;  C2(1)[1] = t1i - q;
+		BIL(X(0)[0], X(0)[1], Z(1)[0], Z(1)[1], t2r, t2i);
+		BIL(X(1)[0], X(1)[1], Z(0)[0], Z(0)[1], p, q);
+		C2(2)[0] = t2r - p;  C2(2)[1] = t2i - q;
+	}
+	return 0;
+}
+
+int P3(crossxy_dotxz_k)(N_ n, const V3F *x, const V3F *y, const V3F *z,
+                        V3F *c, V3F *r, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F t0r, t0i, t1r, t1i, t2r, t2i, p, q, sr = 0, si = 0;
+		BIL(X(1)[0], X(1)[1], Y(2)[0], Y(2)[1], t0r, t0i);
+		BIL(X(2)[0], X(2)[1], Y(1)[0], Y(1)[1], p, q);
+		C(0)[0] = t0r - p;  C(0)[1] = t0i - q;
+		BIL(X(2)[0], X(2)[1], Y(0)[0], Y(0)[1], t1r, t1i);
+		BIL(X(0)[0], X(0)[1], Y(2)[0], Y(2)[1], p, q);
+		C(1)[0] = t1r - p;  C(1)[1] = t1i - q;
+		BIL(X(0)[0], X(0)[1], Y(1)[0], Y(1)[1], t2r, t2i);
+		BIL(X(1)[0], X(1)[1], Y(0)[0], Y(0)[1], p, q);
+		C(2)[0] = t2r - p;  C(2)[1] = t2i - q;
+		BIL(X(0)[0], X(0)[1], Z(0)[0], Z(0)[1], p, q); sr += p;  si += q;
+		BIL(X(1)[0], X(1)[1], Z(1)[0], Z(1)[1], p, q); sr += p;  si += q;
+		BIL(X(2)[0], X(2)[1], Z(2)[0], Z(2)[1], p, q); sr += p;  si += q;
+		R(0)[0] = sr;  R(0)[1] = si;
+	}
+	return 0;
+}
+
+int P3(dotxy_dotxz_k)(N_ n, const V3F *x, const V3F *y, const V3F *z,
+                      V3F *r1, V3F *r2, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F p, q, s1r = 0, s1i = 0, s2r = 0, s2i = 0;
+		BIL(X(0)[0], X(0)[1], Y(0)[0], Y(0)[1], p, q); s1r += p;  s1i += q;
+		BIL(X(1)[0], X(1)[1], Y(1)[0], Y(1)[1], p, q); s1r += p;  s1i += q;
+		BIL(X(2)[0], X(2)[1], Y(2)[0], Y(2)[1], p, q); s1r += p;  s1i += q;
+		BIL(X(0)[0], X(0)[1], Z(0)[0], Z(0)[1], p, q); s2r += p;  s2i += q;
+		BIL(X(1)[0], X(1)[1], Z(1)[0], Z(1)[1], p, q); s2r += p;  s2i += q;
+		BIL(X(2)[0], X(2)[1], Z(2)[0], Z(2)[1], p, q); s2r += p;  s2i += q;
+		R1(0)[0] = s1r;  R1(0)[1] = s1i;
+		R2(0)[0] = s2r;  R2(0)[1] = s2i;
+	}
+	return 0;
+}
