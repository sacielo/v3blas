+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Layer 0 public entries.
+
+Compiled once per precision with -DV3_S, -DV3_D, -DV3_C or -DV3_Z.
+*****************************************************************************/
+
+#include <stdlib.h>
+#include "v3blas.h"
+
+#if defined(V3_S)
+#define P1(x) s1##x
+#define P3(x) s3##x
+typedef float V3F;
+#elif defined(V3_D)
+#define P1(x) d1##x
+#define P3(x) d3##x
+typedef double V3F;
+#elif defined(V3_C)
+#define P1(x) c1##x
+#define P3(x) c3##x
+typedef float V3F;
+#else
+#define P1(x) z1##x
+#define P3(x) z3##x
+typedef double V3F;
+#endif
+
+typedef P1(v) P1V;
+typedef P3(v) P3V;
+
+int P1(scal_k)(int64_t n, V3F a, V3F ai, const V3F *x, int64_t incx,
+               V3F *z, int64_t incz);
+int P1(axpy_k)(int64_t n, V3F a, V3F ai, const V3F *x, int64_t incx,
+               V3F *y, int64_t incy);
+int P1(axpby_k)(int64_t n, V3F a, V3F ai, const V3F *x, int64_t incx,
+                V3F b, V3F bi, const V3F *y, int64_t incy,
+                V3F *z, int64_t incz);
+int P1(had_k)(int64_t n, const V3F *x, int64_t incx, const V3F *y, int64_t incy,
+              V3F *z, int64_t incz);
+int P1(sqr_k)(int64_t n, const V3F *x, int64_t incx, V3F *z, int64_t incz);
+int P1(sqrt_k)(int64_t n, const V3F *x, int64_t incx, V3F *z, int64_t incz);
+
+#define ST(s) P3(set_error_status)(s)
+#define PARAM ST(V3BLAS_PARAM)
+
+#define E1(name, decl, body)					\
+void P1(name) decl						\
+{								\
+	blasint n = n_arg;					\
+	if (n == 0) return;					\
+	if (n < 0) { PARAM; return; }				\
+	if (!x) { PARAM; return; }				\
+	body;							\
+}
+
+#if defined(V3_S) || defined(V3_D)
+
+E1(scal, (blasint n_arg, V3F a, const V3F *x, blasint incx,
+          V3F *z, blasint incz),
+    P1(scal_k)((int64_t)n, a, 0., x, (int64_t)incx, z, (int64_t)incz);)
+
+E1(axpy, (blasint n_arg, V3F a, const V3F *x, blasint incx,
+          V3F *y, blasint incy),
+    P1(axpy_k)((int64_t)n, a, 0., x, (int64_t)incx, y, (int64_t)incy);)
+
+E1(axpby, (blasint n_arg, V3F a, const V3F *x, blasint incx,
+           V3F b, const V3F *y, blasint incy,
+           V3F *z, blasint incz),
+    P1(axpby_k)((int64_t)n, a, 0., x, (int64_t)incx, b, 0., y, (int64_t)incy,
+                z, (int64_t)incz);)
+
+#else
+
+E1(scal, (blasint n_arg, V3F ar, V3F ai, const V3F *x, blasint incx,
+          V3F *z, blasint incz),
+    P1(scal_k)((int64_t)n, ar, ai, x, (int64_t)incx, z, (int64_t)incz);)
+
+E1(axpy, (blasint n_arg, V3F ar, V3F ai, const V3F *x, blasint incx,
+          V3F *y, blasint incy),
+    P1(axpy_k)((int64_t)n, ar, ai, x, (int64_t)incx, y, (int64_t)incy);)
+
+E1(axpby, (blasint n_arg, V3F ar, V3F ai, const V3F *x, blasint incx,
+           V3F br, V3F bi, const V3F *y, blasint incy,
+           V3F *z, blasint incz),
+    P1(axpby_k)((int64_t)n, ar, ai, x, (int64_t)incx, br, bi, y, (int64_t)incy,
+                z, (int64_t)incz);)
+
+#endif
+
+E1(had, (blasint n_arg, const V3F *x, blasint incx, const V3F *y, blasint incy,
+         V3F *z, blasint incz),
+    P1(had_k)((int64_t)n, x, (int64_t)incx, y, (int64_t)incy, z, (int64_t)incz);)
+
+E1(sqr, (blasint n_arg, const V3F *x, blasint incx, V3F *z, blasint incz),
+    P1(sqr_k)((int64_t)n, x, (int64_t)incx, z, (int64_t)incz);)
+
+E1(sqrt, (blasint n_arg, const V3F *x, blasint incx, V3F *z, blasint incz),
+    P1(sqrt_k)((int64_t)n, x, (int64_t)incx, z, (int64_t)incz);)
+
