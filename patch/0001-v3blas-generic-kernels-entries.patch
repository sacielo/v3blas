+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Complex (c/z) Layer 0 bodies.
+
+Compiled once per precision with -DV3_C or -DV3_Z.  V3F is the *real* element
+type: one complex value occupies two adjacent V3F, so a CBLAS inc (which counts
+complex elements) becomes 2*inc in reals.
+
+Every product is bilinear -- no conjugation anywhere.  BIL(R,I,X,Y) expands the
+product of complex X by complex Y into R and I.
+*****************************************************************************/
+
+#include <stdint.h>
+#include <math.h>
+#include <complex.h>
+
+#if defined(V3_C)
+#define P1(x) c1##x
+typedef float V3F;
+typedef float complex V3C;
+#else
+#define P1(x) z1##x
+typedef double V3F;
+typedef double complex V3C;
+#endif
+
+/* int64_t, not BLASLONG: the public entry narrows from blasint, the body
+   widens so a Layer-0 call cannot truncate inside a chunked split. */
+#define N_ int64_t
+
+#define BIL(pr, pi, qr, qi, kr, ki)	\
+	do {				\
+		(kr) = (pr) * (qr) - (pi) * (qi);	\
+		(ki) = (pr) * (qi) + (pi) * (qr);	\
+	} while (0)
+
+/* A negative inc walks backwards from element n-1; an inc of 0 holds at
+   element 0, which is the broadcast. */
+#define START(inc) ((inc) < 0 ? (1 - n) * (inc) : 0)
+
+int P1(scal_k)(N_ n, V3F ar, V3F ai, const V3F *x, N_ incx, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iz += incz) {
+		z[2 * iz]     = ar * x[2 * ix]     - ai * x[2 * ix + 1];
+		z[2 * iz + 1] = ar * x[2 * ix + 1] + ai * x[2 * ix];
+	}
+	return 0;
+}
+
+int P1(axpy_k)(N_ n, V3F ar, V3F ai, const V3F *x, N_ incx,
+               V3F *y, N_ incy)
+{
+	N_ i, ix = START(incx), iy = START(incy);
+	for (i = 0; i < n; i++, ix += incx, iy += incy) {
+		y[2 * iy]     += ar * x[2 * ix]     - ai * x[2 * ix + 1];
+		y[2 * iy + 1] += ar * x[2 * ix + 1] + ai * x[2 * ix];
+	}
+	return 0;
+}
+
+int P1(axpby_k)(N_ n, V3F ar, V3F ai, const V3F *x, N_ incx,
+                V3F br, V3F bi, const V3F *y, N_ incy, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iy = START(incy), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iy += incy, iz += incz) {
+		z[2 * iz]     = (ar * x[2 * ix]     - ai * x[2 * ix + 1])
+			      + (br * y[2 * iy]     - bi * y[2 * iy + 1]);
+		z[2 * iz + 1] = (ar * x[2 * ix + 1] + ai * x[2 * ix])
+			      + (br * y[2 * iy + 1] + bi * y[2 * iy]);
+	}
+	return 0;
+}
+
+int P1(had_k)(N_ n, const V3F *x, N_ incx, const V3F *y, N_ incy,
+              V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iy = START(incy), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iy += incy, iz += incz)
+		BIL(x[2 * ix], x[2 * ix + 1], y[2 * iy], y[2 * iy + 1],
+		    z[2 * iz], z[2 * iz + 1]);
+	return 0;
+}
+
+int P1(sqr_k)(N_ n, const V3F *x, N_ incx, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iz += incz)
+		BIL(x[2 * ix], x[2 * ix + 1], x[2 * ix], x[2 * ix + 1],
+		    z[2 * iz], z[2 * iz + 1]);
+	return 0;
+}
+
+/* principal square root of a complex value, no conjugation in the input */
+int P1(sqrt_k)(N_ n, const V3F *x, N_ incx, V3F *z, N_ incz)
+{
+	N_ i, ix = START(incx), iz = 0;
+	for (i = 0; i < n; i++, ix += incx, iz += incz) {
+		V3C v = x[2 * ix] + x[2 * ix + 1] * _Complex_I;
+		V3C w = csqrt(v);
+		z[2 * iz]     = (V3F) creal(w);
+		z[2 * iz + 1] = (V3F) cimag(w);
+	}
+	return 0;
+}
