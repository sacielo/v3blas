+++ b/kernel/generic/v3.c
@@ -0,0 +1,193 @@
+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Real (s/d) Layer 1 bodies.
+
+Compiled once per precision with -DV3_S or -DV3_D.  Every body is a plain
+element loop: inc > 0 always, the entry has already normalised a negative
+stride onto the base pointer, and nothing is written past element n-1.
+
+The X/Y/Z/C/R macros index element i, component k, of the loop variable of the
+same name.  Every body uses x, y, z, c, c1, c2, r, r1, r2 for the same things.
+*****************************************************************************/
+
+#include <stdint.h>
+
+#if defined(V3_S)
+#define P3(x) s3##x
+typedef float V3F;
+#else
+#define P3(x) d3##x
+typedef double V3F;
+#endif
+
+/* int64_t, not BLASLONG: N = 1e8..1e10 overflows a 32-bit index and Layer 1
+   promises 64.  BLASLONG is 32-bit in a default OpenBLAS build. */
+#define N_ int64_t
+
+#define X(k) (*(x + i * inc + (k) * cinc))
+#define Y(k) (*(y + i * inc + (k) * cinc))
+#define Z(k) (*(z + i * inc + (k) * cinc))
+#define C(k) (*(c + i * inc + (k) * cinc))
+#define C1(k) (*(c1 + i * inc + (k) * cinc))
+#define C2(k) (*(c2 + i * inc + (k) * cinc))
+#define R(k)  (*(r  + i * inc + (k) * cinc))
+#define R1(k) (*(r1 + i * inc + (k) * cinc))
+#define R2(k) (*(r2 + i * inc + (k) * cinc))
+
+int P3(cross_k)(N_ n, const V3F *x, const V3F *y, V3F *c,
+                N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		C(0) = X(1) * Y(2) - X(2) * Y(1);
+		C(1) = X(2) * Y(0) - X(0) * Y(2);
+		C(2) = X(0) * Y(1) - X(1) * Y(0);
+	}
+	return 0;
+}
+
+int P3(crossscal_k)(N_ n, const V3F *x, const V3F *y, V3F a,
+                    V3F *c, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		C(0) = a * (X(1) * Y(2) - X(2) * Y(1));
+		C(1) = a * (X(2) * Y(0) - X(0) * Y(2));
+		C(2) = a * (X(0) * Y(1) - X(1) * Y(0));
+	}
+	return 0;
+}
+
+int P3(crossdot_k)(N_ n, const V3F *x, const V3F *y,
+                   const V3F *z, V3F *r, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F c0 = X(1) * Y(2) - X(2) * Y(1);
+		V3F c1 = X(2) * Y(0) - X(0) * Y(2);
+		V3F c2 = X(0) * Y(1) - X(1) * Y(0);
+		R(0) = c0 * Z(0) + c1 * Z(1) + c2 * Z(2);
+	}
+	return 0;
+}
+
+int P3(crosssqr_k)(N_ n, const V3F *x, const V3F *y, V3F *r,
+                   N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		V3F c0 = X(1) * Y(2) - X(2) * Y(1);
+		V3F c1 = X(2) * Y(0) - X(0) * Y(2);
+		V3F c2 = X(0) * Y(1) - X(1) * Y(0);
+		R(0) = c0 * c0 + c1 * c1 + c2 * c2;
+	}
+	return 0;
+}
+
+int P3(dot_k)(N_ n, const V3F *x, const V3F *y, V3F *r,
+              N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++)
+		R(0) = X(0) * Y(0) + X(1) * Y(1) + X(2) * Y(2);
+	return 0;
+}
+
+int P3(sqr_k)(N_ n, const V3F *x, V3F *z, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++)
+		Z(0) = X(0) * X(0) + X(1) * X(1) + X(2) * X(2);
+	return 0;
+}
+
+int P3(had_k)(N_ n, const V3F *x, const V3F *y, V3F *z,
+              N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		Z(0) = X(0) * Y(0);
+		Z(1) = X(1) * Y(1);
+		Z(2) = X(2) * Y(2);
+	}
+	return 0;
+}
+
+int P3(scal_k)(N_ n, const V3F *x, V3F a, V3F *z,
+               N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		Z(0) = a * X(0);
+		Z(1) = a * X(1);
+		Z(2) = a * X(2);
+	}
+	return 0;
+}
+
+int P3(axpy_k)(N_ n, const V3F *x, V3F a, const V3F *y, V3F *z,
+               N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		Z(0) = a * X(0) + Y(0);
+		Z(1) = a * X(1) + Y(1);
+		Z(2) = a * X(2) + Y(2);
+	}
+	return 0;
+}
+
+int P3(axpby_k)(N_ n, const V3F *x, V3F a, const V3F *y, V3F b,
+                V3F *z, N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		Z(0) = a * X(0) + b * Y(0);
+		Z(1) = a * X(1) + b * Y(1);
+		Z(2) = a * X(2) + b * Y(2);
+	}
+	return 0;
+}
+
+/* ---- forks: all share the first operand, vary the second ---- */
+
+int P3(crossxy_crossxz_k)(N_ n, const V3F *x, const V3F *y,
+                          const V3F *z, V3F *c1, V3F *c2,
+                          N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		C1(0) = X(1) * Y(2) - X(2) * Y(1);
+		C1(1) = X(2) * Y(0) - X(0) * Y(2);
+		C1(2) = X(0) * Y(1) - X(1) * Y(0);
+		C2(0) = X(1) * Z(2) - X(2) * Z(1);
+		C2(1) = X(2) * Z(0) - X(0) * Z(2);
+		C2(2) = X(0) * Z(1) - X(1) * Z(0);
+	}
+	return 0;
+}
+
+int P3(crossxy_dotxz_k)(N_ n, const V3F *x, const V3F *y,
+                        const V3F *z, V3F *c, V3F *r,
+                        N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		C(0) = X(1) * Y(2) - X(2) * Y(1);
+		C(1) = X(2) * Y(0) - X(0) * Y(2);
+		C(2) = X(0) * Y(1) - X(1) * Y(0);
+		R(0) = X(0) * Z(0) + X(1) * Z(1) + X(2) * Z(2);
+	}
+	return 0;
+}
+
+int P3(dotxy_dotxz_k)(N_ n, const V3F *x, const V3F *y,
+                      const V3F *z, V3F *r1, V3F *r2,
+                      N_ inc, N_ cinc)
+{
+	N_ i;
+	for (i = 0; i < n; i++) {
+		R1(0) = X(0) * Y(0) + X(1) * Y(1) + X(2) * Y(2);
+		R2(0) = X(0) * Z(0) + X(1) * Z(1) + X(2) * Z(2);
+	}
+	return 0;
+}
