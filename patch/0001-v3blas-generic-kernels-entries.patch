new file mode 100644
index 000000000..93a8aa4cf
--- /dev/null
+++ b/interface/ew_ctor.c
@@ -0,0 +1,57 @@
+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Layer 0 constructors and status.
+*****************************************************************************/
+
+#include <stdlib.h>
+#include "v3blas.h"
+
+#if defined(V3_S)
+#define P1(x) s1##x
+#define P3(x) s3##x
+typedef float V3F;
+#elif defined(V3_D)
+#define P1(x) d1##x
+#define P3(x) d3##x
+typedef double V3F;
+#elif defined(V3_C)
+#define P1(x) c1##x
+#define P3(x) c3##x
+typedef float V3F;
+#else
+#define P1(x) z1##x
+#define P3(x) z3##x
+typedef double V3F;
+#endif
+
+typedef P1(v) P1V;
+
+static _Thread_local int v3_status = V3BLAS_OK;
+void P3(set_error_status)(int status) { v3_status = status; }
+int  P3(get_error_status)(void)       { return v3_status; }
+
+P1V *P1(create)(blasint n)
+{
+	P1V *v;
+	V3F *base;
+	if (n < 0) return NULL;
+	base = (V3F *)calloc(n > 0 ? n : 1, sizeof(V3F));
+	if (!base) return NULL;
+	v = (P1V *)malloc(sizeof(P1V));
+	if (!v) { free(base); return NULL; }
+	v->p = base; v->n = n; v->inc = 1;
+	return v;
+}
+
+P1V *P1(wrap)(P1V *out, V3F *base, blasint n, blasint inc)
+{
+	if (!out || !base || n < 0) return NULL;
+	out->p = base; out->n = n; out->inc = inc;
+	return out;
+}
+
+void P1(destroy)(P1V *v)
+{
+	if (!v) return;
+	free(v->p);
+	free(v);
+}
diff --git a/interface/v3.c b/interface/v3.c
new file mode 100644
index 000000000..91867dec8
--- /dev/null
+++ b/interface/v3.c
@@ -0,0 +1,208 @@
+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Layer 1 public entries and the
+handle constructors, for one precision.  Compiled once per precision with
+-DV3_S, -DV3_D, -DV3_C or -DV3_Z.
+
+An entry does the three things a body must not: validate, normalise a negative
+stride onto the base pointer, and hand the body a contiguous element range.
+The body is then a plain loop over one chunk.
+
+Every rule here comes from the v3blas spec: n == 0 is a quick return that
+changes nothing, validation completes before any store, and the status is set
+rather than returned, per precision and per thread.
+*****************************************************************************/
+
+#include <stdlib.h>
+#include "v3blas.h"
+
+/* ---- per-precision names and types ---- */
+
+#if defined(V3_S)
+#define P3(x) s3##x
+#define P1(x) s1##x
+typedef float V3F;
+#define SCAL_DECL(T)   T a
+#define SCAL_ARG        a
+#define SCALB_DECL(T)  T b
+#define SCALB_ARG       b
+#define KA(V3F)         V3F
+#elif defined(V3_D)
+#define P3(x) d3##x
+#define P1(x) d1##x
+typedef double V3F;
+#define SCAL_DECL(T)   T a
+#define SCAL_ARG        a
+#define SCALB_DECL(T)  T b
+#define SCALB_ARG       b
+#define KA(V3F)         V3F
+#elif defined(V3_C)
+#define P3(x) c3##x
+#define P1(x) c1##x
+typedef float V3F;
+#define SCAL_DECL(T)   T ar, T ai
+#define SCAL_ARG        ar, ai
+#define SCALB_DECL(T)  T br, T bi
+#define SCALB_ARG       br, bi
+#define KA(V3F)         V3F, V3F
+#else
+#define P3(x) z3##x
+#define P1(x) z1##x
+typedef double V3F;
+#define SCAL_DECL(T)   T ar, T ai
+#define SCAL_ARG        ar, ai
+#define SCALB_DECL(T)  T br, T bi
+#define SCALB_ARG       br, bi
+#define KA(V3F)         V3F, V3F
+#endif
+
+typedef P3(v) P3V;
+typedef P1(v) P1V;
+
+/* ---- error status: per precision, per thread ---- */
+
+static _Thread_local int v3_status = V3BLAS_OK;
+
+void P3(set_error_status)(int status) { v3_status = status; }
+int  P3(get_error_status)(void)       { return v3_status; }
+
+/* ---- internal bodies (declared here, not in common_level1.h: those
+        prototypes are for OpenBLAS's own kernels and none of our names or
+        types belong in that file) ---- */
+
+int P3(cross_k)    (int64_t, const V3F *, const V3F *, V3F *, int64_t, int64_t);
+int P3(crossscal_k)(int64_t, const V3F *, const V3F *, KA(V3F), V3F *, int64_t, int64_t);
+int P3(crossdot_k) (int64_t, const V3F *, const V3F *, const V3F *, V3F *,
+                    int64_t, int64_t);
+int P3(crosssqr_k) (int64_t, const V3F *, const V3F *, V3F *, int64_t, int64_t);
+int P3(dot_k)      (int64_t, const V3F *, const V3F *, V3F *, int64_t, int64_t);
+int P3(sqr_k)      (int64_t, const V3F *, V3F *, int64_t, int64_t);
+int P3(had_k)      (int64_t, const V3F *, const V3F *, V3F *, int64_t, int64_t);
+int P3(scal_k)     (int64_t, const V3F *, KA(V3F), V3F *, int64_t, int64_t);
+int P3(axpy_k)     (int64_t, const V3F *, KA(V3F), const V3F *, V3F *, int64_t, int64_t);
+int P3(axpby_k)    (int64_t, const V3F *, KA(V3F), const V3F *, KA(V3F), V3F *, int64_t, int64_t);
+int P3(crossxy_crossxz_k)(int64_t, const V3F *, const V3F *, const V3F *,
+                          V3F *, V3F *, int64_t, int64_t);
+int P3(crossxy_dotxz_k)  (int64_t, const V3F *, const V3F *, const V3F *,
+                          V3F *, V3F *, int64_t, int64_t);
+int P3(dotxy_dotxz_k)    (int64_t, const V3F *, const V3F *, const V3F *,
+                          V3F *, V3F *, int64_t, int64_t);
+
+/* ---- validation ---- */
+
+#define ST(s)   P3(set_error_status)(s)
+#define PARAM   ST(V3BLAS_PARAM)
+
+/* Validate the 3-vector operands and the common n, inc, cinc.  A NULL handle
+   has no n to inspect, so the NULL test necessarily runs first.
+   0 = go, 1 = quick return (n == 0), -1 = V3BLAS_PARAM. */
+static int v3pre(int nh, const P3V *const *h, int64_t *pn,
+                 int64_t *pinc, int64_t *pcinc)
+{
+	int i;
+	int64_t n, inc, cinc;
+
+	for (i = 0; i < nh; i++)
+		if (!h[i] || !h[i]->x) return -1;
+
+	n = h[0]->n;
+	if (n == 0) return 1;
+	inc = h[0]->inc;
+	cinc = h[0]->cinc;
+
+	if (n < 0 || inc == 0 || cinc != 3 * inc) return -1;
+
+	for (i = 1; i < nh; i++)
+		if (h[i]->n != n || h[i]->inc != inc) return -1;
+
+	*pn = n; *pinc = inc; *pcinc = cinc;
+	return 0;
+}
+
+/* A scalar-array handle has no components, so it has no cinc: it must agree
+   on n and inc and be non-NULL.  Called after v3pre has ruled out n == 0. */
+static int chk1(const P1V *r, int64_t n, int64_t inc)
+{
+	return (!r || !r->p || r->n != n || r->inc != inc) ? -1 : 0;
+}
+
+/* Every entry is this: gather handles, validate, normalise a negative stride
+   onto the base pointer, call the body. */
+/* E3(name, decl, body, SCALARS_NULL, V3ARGS...) */
+#define E3(name, decl, body, SCALARS_NULL, ...)			\
+void P3(name) decl						\
+{								\
+	const P3V *h[16];					\
+	const P1V *sc[16];					\
+	int nh = 0, ns = 0, i;					\
+	do { const P1V *sl[] = { SCALARS_NULL };		\
+	     for (i = 0; i < (int)(sizeof sl/sizeof sl[0]); i++) { if (sl[i]) sc[ns++] = sl[i]; } } while (0);\
+	do { const P3V *vl[] = { __VA_ARGS__ };			\
+	     for (i = 0; i < (int)(sizeof vl/sizeof vl[0]); i++) { if (vl[i]) h[nh++] = vl[i]; } } while (0);\
+	int64_t n, inc, cinc, off = 0;				\
+	int rc = v3pre(nh, h, &n, &inc, &cinc);			\
+	if (rc) { if (rc < 0) PARAM; return; }			\
+	for (i = 0; i < ns; i++) if (chk1(sc[i], n, inc) < 0) { PARAM; return; }\
+	if (inc < 0) { off = (n - 1) * -inc; inc = -inc; }	\
+	body;							\
+}
+
+/* ---- Layer 1 entries ---- */
+
+E3(scal, (const P3V *x, SCAL_DECL(V3F), P3V *z),
+   P3(scal_k)(n, x->x + off, SCAL_ARG, z->x + off, inc, cinc);,
+   0, x, z)
+
+E3(axpy, (const P3V *x, SCAL_DECL(V3F), P3V *y),
+   P3(axpy_k)(n, x->x + off, SCAL_ARG, y->x + off, y->x + off, inc, cinc);,
+   0, x, y)
+
+E3(axpby, (const P3V *x, SCAL_DECL(V3F), const P3V *y, SCALB_DECL(V3F), P3V *z),
+   P3(axpby_k)(n, x->x + off, SCAL_ARG, y->x + off, SCALB_ARG,
+               z->x + off, inc, cinc);,
+   0, x, y, z)
+
+E3(had, (const P3V *x, const P3V *y, P3V *z),
+   P3(had_k)(n, x->x + off, y->x + off, z->x + off, inc, cinc);,
+   0, x, y, z)
+
+E3(cross, (const P3V *x, const P3V *y, P3V *c),
+   P3(cross_k)(n, x->x + off, y->x + off, c->x + off, inc, cinc);,
+   0, x, y, c)
+
+E3(crossscal, (const P3V *x, const P3V *y, SCAL_DECL(V3F), P3V *c),
+   P3(crossscal_k)(n, x->x + off, y->x + off, SCAL_ARG, c->x + off,
+                   inc, cinc);,
+   0, x, y, c)
+
+E3(dot, (const P3V *x, const P3V *y, P1V *r),
+   P3(dot_k)(n, x->x + off, y->x + off, r->p + off, inc, cinc);,
+   r, x, y)
+
+E3(sqr, (const P3V *x, P3V *z),
+   P3(sqr_k)(n, x->x + off, z->x + off, inc, cinc);,
+   0, x, z)
+
+E3(crossdot, (const P3V *x, const P3V *y, const P3V *z, P1V *r),
+   P3(crossdot_k)(n, x->x + off, y->x + off, z->x + off, r->p + off,
+                  inc, cinc);,
+   r, x, y, z)
+
+E3(crosssqr, (const P3V *x, const P3V *y, P1V *r),
+   P3(crosssqr_k)(n, x->x + off, y->x + off, r->p + off, inc, cinc);,
+   r, x, y)
+
+E3(crossxy_crossxz,
+   (const P3V *x, const P3V *y, const P3V *z, P3V *c1, P3V *c2),
+   P3(crossxy_crossxz_k)(n, x->x + off, y->x + off, z->x + off,
+                         c1->x + off, c2->x + off, inc, cinc);,
+   0, x, y, z, c1, c2)
+
+E3(crossxy_dotxz, (const P3V *x, const P3V *y, const P3V *z, P3V *c, P1V *r),
+   P3(crossxy_dotxz_k)(n, x->x + off, y->x + off, z->x + off,
+                       c->x + off, r->p + off, inc, cinc);,
+   r, x, y, z, c)
+
+E3(dotxy_dotxz, (const P3V *x, const P3V *y, const P3V *z, P1V *r1, P1V *r2),
+   P3(dotxy_dotxz_k)(n, x->x + off, y->x + off, z->x + off,
+                     r1->p + off, r2->p + off, inc, cinc);,
+   0, x, y, z)
diff --git a/interface/v3_ctor.c b/interface/v3_ctor.c
new file mode 100644
index 000000000..1a0e94587
--- /dev/null
+++ b/interface/v3_ctor.c
@@ -0,0 +1,82 @@
+/*****************************************************************************
+Copyright (c) 2026, v3blas contributors.  Layer 1 constructors and status.
+*****************************************************************************/
+
+#include <stdlib.h>
+#include "v3blas.h"
+
+#if defined(V3_S)
+#define P3(x) s3##x
+#define P1(x) s1##x
+typedef float V3F;
+#elif defined(V3_D)
+#define P3(x) d3##x
+#define P1(x) d1##x
+typedef double V3F;
+#elif defined(V3_C)
+#define P3(x) c3##x
+#define P1(x) c1##x
+typedef float V3F;
+#else
+#define P3(x) z3##x
+#define P1(x) z1##x
+typedef double V3F;
+#endif
+
+typedef P3(v) P3V;
+typedef P1(v) P1V;
+
+static _Thread_local int v3_status = V3BLAS_OK;
+void P3(set_error_status)(int status) { v3_status = status; }
+int  P3(get_error_status)(void)       { return v3_status; }
+
+int64_t P3(pitch)(int64_t n) { return ((3 * n + 7) / 8) * 8; }
+
+P3V *P3(create)(int64_t n)
+{
+	P3V *v;
+	V3F *base;
+	if (n < 0) return NULL;
+	base = (V3F *)calloc(P3(pitch)(n) ? P3(pitch)(n) : 1, sizeof(V3F));
+	if (!base) return NULL;
+	v = (P3V *)malloc(sizeof(P3V));
+	if (!v) { free(base); return NULL; }
+	v->x = base; v->y = NULL; v->z = NULL;
+	v->n = n; v->inc = 1; v->cinc = 3;
+	return v;
+}
+
+P3V *P3(wrap)(P3V *out, V3F *base, int64_t n, int64_t inc)
+{
+	if (!out || !base || n < 0 || inc == 0) return NULL;
+	out->x = base; out->y = NULL; out->z = NULL;
+	out->n = n; out->inc = inc; out->cinc = 3 * inc;
+	return out;
+}
+
+P3V *P3(wrap_component)(P3V *out, const P3V *v, int k)
+{
+	if (!out || !v || !v->x) return NULL;
+	if (k < 0) { *out = *v; return out; }
+	if (k > 2) return NULL;
+	out->x = v->x + k * v->cinc;
+	out->y = NULL; out->z = NULL;
+	out->n = v->n; out->inc = v->inc; out->cinc = v->cinc;
+	return out;
+}
+
+P1V P3(component)(const P3V *v, int k)
+{
+	P1V r;
+	if (!v || !v->x || k < 0 || k > 2) { r.p = NULL; r.n = 0; r.inc = 0; return r; }
+	r.p = v->x + k * v->cinc;
+	r.n = v->n; r.inc = v->inc;
+	return r;
+}
+
+void P3(destroy)(P3V *v)
+{
+	if (!v) return;
+	free(v->x);
+	free(v);
+}
